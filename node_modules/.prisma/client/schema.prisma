generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Entreprise {
  id               String           @id @default(uuid())
  nomEntreprise    String           @unique
  email            String
  secteurActivite  String
  numeroEntreprise String
  nomGerant        String
  motDePasseHash   String
  emailConfirme    Boolean          @default(false)
  codeConfirmation String?
  codeExpiration   DateTime?
  createdAt        DateTime         @default(now())
  vendeurs         Vendeur[]
  fournisseurs     Fournisseur[]
  produits         Produit[]
  ventes           Vente[]
  mouvementsStock  MouvementStock[]
  connexions       Connexion[]
}

model Vendeur {
  id             String           @id @default(uuid())
  nomPrenoms     String
  email          String
  telephone      String
  motDePasseHash String
  entreprise     Entreprise       @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId   String
  createdAt      DateTime         @default(now())
  ventes         Vente[]
  mouvements     MouvementStock[]
  connexions     Connexion[]
}

model Admin {
  id             String @id @default(uuid())
  identifiant    String @unique
  motDePasseHash String
}

model Fournisseur {
  id           String     @id @default(uuid())
  nom          String
  telephone    String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String
  produits     Produit[]
  createdAt    DateTime   @default(now())
}

model Produit {
  id            String           @id @default(uuid())
  nom           String
  categorie     String
  prixAchat     Int
  prixVente     Int
  stockActuel   Int              @default(0)
  seuilAlerte   Int              @default(0)
  // Un produit déjà vendu ne peut pas être supprimé sans casser
  // l'historique des ventes -> on l'archive à la place (il
  // disparaît du stock actif, mais reste rattaché à ses ventes
  // passées).
  estArchive    Boolean          @default(false)
  entreprise    Entreprise       @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId  String
  fournisseur   Fournisseur?     @relation(fields: [fournisseurId], references: [id])
  fournisseurId String?
  ventes        Vente[]
  mouvements    MouvementStock[]
  createdAt     DateTime         @default(now())
}

model Vente {
  id           String     @id @default(uuid())
  quantite     Int
  prixUnitaire Int
  total        Int
  // Montant de la remise appliquée à CETTE ligne de vente (en CFA).
  // "total" reste le montant brut (quantite * prixUnitaire) ; le net
  // encaissé est "total - remise". Quand une remise vise tout le
  // panier, elle est répartie au prorata sur chaque ligne créée.
  remise       Int        @default(0)
  dateVente    DateTime   @default(now())
  produit      Produit    @relation(fields: [produitId], references: [id])
  produitId    String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String
  vendeur      Vendeur?   @relation(fields: [vendeurId], references: [id])
  vendeurId    String?
}

model MouvementStock {
  id            String     @id @default(uuid())
  type          String
  quantite      Int
  dateMouvement DateTime   @default(now())
  produit       Produit    @relation(fields: [produitId], references: [id])
  produitId     String
  entreprise    Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId  String
  vendeur       Vendeur?   @relation(fields: [vendeurId], references: [id])
  vendeurId     String?
}

model Connexion {
  id           String     @id @default(uuid())
  type         String
  dateHeure    DateTime   @default(now())
  vendeur      Vendeur    @relation(fields: [vendeurId], references: [id], onDelete: Cascade)
  vendeurId    String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  entrepriseId String
}
